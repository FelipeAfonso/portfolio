---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  src: ImageMetadata;
  alt: string;
  caption?: string;
  chrome?: boolean;
  url?: string;
  href?: string;
  eager?: boolean;
  tone?: "light" | "dark" | "niterra" | "crisalida";
  sizes?: string;
  widths?: number[];
  class?: string;
  captionClass?: string;
  /** entrance variant consumed by motion.ts ("left" | "right" | "scale") */
  reveal?: "left" | "right" | "scale";
  /** scrubbed yPercent shear, desktop only (motion.ts) */
  parallax?: number;
}

const {
  src,
  alt,
  caption,
  chrome = false,
  url,
  href,
  eager = false,
  tone = "light",
  sizes = "(min-width: 1024px) 42vw, 92vw",
  widths = [480, 768, 1080],
  class: cls = "",
  captionClass,
  reveal,
  parallax,
} = Astro.props;

const tones = {
  light: {
    frame: "border-rule bg-paper-raised",
    cap: "text-ink",
    dot: "bg-rule",
    url: "text-ink",
    chromeRule: "border-rule",
    halo: "--color-accent",
  },
  dark: {
    frame: "border-wq-frame bg-wq-ground",
    cap: "text-wq-lime",
    dot: "bg-rule",
    url: "text-ink",
    chromeRule: "border-wq-frame",
    halo: "--color-wq-lime",
  },
  niterra: {
    frame: "border-ni-line bg-white",
    cap: "text-ni-ink-muted",
    dot: "bg-ni-teal-deep/40",
    url: "text-ni-ink-muted",
    chromeRule: "border-ni-line",
    halo: "--color-ni-teal",
  },
  crisalida: {
    frame: "border-cs-line bg-cs-card",
    cap: "text-cs-ink-muted",
    dot: "bg-cs-sage/40",
    url: "text-cs-ink-muted",
    chromeRule: "border-cs-line",
    halo: "--color-cs-sage",
  },
}[tone];
const frame = tones.frame;
const capColor = captionClass ?? tones.cap;
const dotColor = tones.dot;
const urlColor = tones.url;
const hasCaption = Boolean(caption) || Astro.slots.has("caption");
const halo = tones.halo;
---

<figure
  class={`group reveal ${cls}`}
  data-reveal={reveal}
  data-parallax={parallax}
>
  <div
    class={`plate-frame overflow-hidden rounded-[3px] border ${frame}`}
    style={`--plate-halo: var(${halo});`}
  >
    {
      chrome && (
        <div
          class={`flex items-center gap-2 border-b px-3 py-2 ${tones.chromeRule}`}
        >
          <span class="flex gap-1.5" aria-hidden="true">
            <span class={`h-2.5 w-2.5 rounded-full ${dotColor}`} />
            <span class={`h-2.5 w-2.5 rounded-full ${dotColor}`} />
            <span class={`h-2.5 w-2.5 rounded-full ${dotColor}`} />
          </span>
          {url &&
            (href ? (
              <a
                href={href}
                target="_blank"
                rel="noopener noreferrer"
                class={`truncate font-mono text-[0.7rem] underline-offset-2 hover:underline ${urlColor}`}
              >
                {url}
              </a>
            ) : (
              <span class={`truncate font-mono text-[0.7rem] ${urlColor}`}>
                {url}
              </span>
            ))}
        </div>
      )
    }
    <Image
      src={src}
      alt={alt}
      sizes={sizes}
      widths={widths}
      loading={eager ? "eager" : "lazy"}
      decoding="async"
      class="block h-auto w-full transition-transform duration-500 group-hover:scale-[1.012]"
    />
  </div>
  {
    hasCaption && (
      <figcaption
        class={`mt-2.5 font-mono text-[0.8125rem] leading-relaxed ${capColor}`}
      >
        <slot name="caption">{caption}</slot>
      </figcaption>
    )
  }
</figure>
